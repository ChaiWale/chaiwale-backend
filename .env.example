# ==============================================================================
# CHAIWALE Central Backend - Production Environment Configuration
# Template File: backend/.env.example
# ==============================================================================

NODE_ENV=production
PORT=5000

# Canonical Application & Service URLs
APP_URL=https://chaiwale.co.in
API_URL=https://api.chaiwale.co.in
ADMIN_URL=https://admin.chaiwale.co.in
BILLBOOK_URL=https://bills.chaiwale.co.in

# Production Allowed Origins for CORS (Strict comma-separated list - NO localhost in production)
CORS_ORIGINS=https://chaiwale.co.in,https://www.chaiwale.co.in,https://admin.chaiwale.co.in,https://bills.chaiwale.co.in

# Supabase Project Connection & Credentials (Placeholders for manual entry)
SUPABASE_URL=<ENTER_SUPABASE_URL_HERE>
SUPABASE_ANON_KEY=<ENTER_SUPABASE_ANON_KEY_HERE>
SUPABASE_SERVICE_ROLE_KEY=<ENTER_SUPABASE_SERVICE_ROLE_KEY_HERE>

# Resend Transactional Email Service (Placeholder for manual entry)
RESEND_API_KEY=<ENTER_RESEND_API_KEY_HERE>

# Resend Sender Identities (Verified domain: chaiwale.co.in)
EMAIL_FROM_BILLS="Chaiwale Invoice <bills@chaiwale.co.in>"
EMAIL_FROM_ORDERS="Chaiwale Orders <orders@chaiwale.co.in>"
EMAIL_FROM_SUPPORT="Chaiwale Support <support@chaiwale.co.in>"

# Internal Operations Receiving Address (INTERNAL ONLY - never exposed to customers)
SUPPORT_NOTIFICATION_EMAIL=chaiwale528@gmail.com

# ------------------------------------------------------------------------------
# SECURITY NOTICE:
# - This file is a TEMPLATE only. Do NOT put live secrets into .env.example.
# - Actual production secrets must be entered into Vercel Environment Variables.
# - SUPABASE_SERVICE_ROLE_KEY and RESEND_API_KEY must remain strictly backend-only.
# ------------------------------------------------------------------------------
